# Application
APP_NAME=DeepFake OTOP
APP_ENV=development
# C10: No default — must be set explicitly; app refuses to start without it
SECRET_KEY=change-me-in-production
# C1: API key that clients must send in the X-API-Key header
# Leave empty to disable auth in local development
API_KEY=

# Storage backend: "local" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs
MODELS_DIR=/app/models

# AWS S3 (only when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=deepfake-otop-media
CLOUDFRONT_DOMAIN=

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Model paths
FOMM_DIR=/app/models/first-order-model
FOMM_CONFIG=config/vox-256.yaml
FOMM_CHECKPOINT=/app/models/checkpoints/vox-cpk.pth.tar

WAV2LIP_DIR=/app/models/Wav2Lip
WAV2LIP_CHECKPOINT=/app/models/checkpoints/wav2lip_gan.pth

# Processing limits
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_DURATION_SECONDS=300
PROCESSING_DEVICE=auto

# API / CORS
# Absolute URL that remote clients (mobile, browser) use to reach this API.
# Used by Celery workers to build downloadable result URLs.
# Example (production): https://api.otopgestion.com
# Leave empty in local dev — the URL is auto-detected from the incoming request.
EXTERNAL_BASE_URL=https://api.otopgestion.com

# Comma-separated list of allowed CORS origins.
# Production: the frontend URL only.  Never use * in production with credentials.
CORS_ORIGINS=https://app.otopgestion.com
